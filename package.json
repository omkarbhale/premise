{
  "name": "premise",
  "version": "0.1.0",
  "private": true,
  "description": "Takes software from an idea to running software, with LLMs doing everything an LLM can do.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "premise": "dist/server/cli.js"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/cli.ts start",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start": "node dist/server/cli.js start",
    "doctor": "node dist/server/cli.js doctor",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "docs:config": "tsx src/cli.ts config reference > docs/reference/configuration.md",
    "new-link": "node dist/server/cli.js new-link",
    "test:browser": "vitest run test/browser"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
